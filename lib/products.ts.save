export const products:Product[]=seed.map(([id,name,price,category,photo,badge:badge ?? ''],i)=>({id,name,price,category,image:img(photo),rating:4.7+(i%3)/10,description:`A considered staple from HappyFarmacy — carefully sourced, naturally made, and full of uncomplicated flavour.`,benefits:['Naturally grown','No artificial additives','Small-batch packed'],ingredients:'Pure farm-grown ingredients. Nothing unnecessary.',nutrition:'Wholesome goodness in every serving.',badge}));
export const getProduct=(id:string)=>products.find(p=>p.id===id);
